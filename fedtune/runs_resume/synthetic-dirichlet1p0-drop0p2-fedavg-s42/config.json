{
  "experiment": {
    "seed": 42,
    "rounds": 12,
    "num_clients": 6,
    "strategy": [
      "fedavg"
    ]
  },
  "data": {
    "task": "classification",
    "dataset": "synthetic",
    "max_samples": 2000,
    "max_length": 32,
    "test_fraction": 0.2,
    "val_fraction": 0.1,
    "partition": {
      "mode": "dirichlet",
      "alpha": 1.0,
      "heterogeneity": 0.8
    }
  },
  "model": {
    "base": "tiny-random",
    "lora": {
      "rank": 4,
      "alpha": 8,
      "dropout": 0.05,
      "target_modules": null
    }
  },
  "train": {
    "local_epochs": 3,
    "lr": 0.003,
    "batch_size": 16
  },
  "dropout": {
    "rate": 0.2,
    "min_participants": 2
  },
  "aggregation": {
    "lora_method": "adapter_average"
  },
  "checkpoint": {
    "every": 1,
    "keep": 2
  },
  "network": {
    "profile": "off",
    "uplink_mbps": 10.0,
    "downlink_mbps": 50.0,
    "latency_ms": 50.0,
    "slowdown": 1.0,
    "deadline_s": null,
    "step_time_s": 0.1,
    "jitter": 0.0,
    "assignment": "random"
  },
  "grid": null
}